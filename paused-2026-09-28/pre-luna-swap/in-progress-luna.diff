+def parse_packet_files(packet: str) -> dict[str, str]:
+    """Pull the files a real worker would write out of the packet text.
+
+    A real worker reads the packet and writes the files it names. The planner packets name them in numbered
+    steps, e.g.:
+      (1) src/calc_power.py, exact content (trailing newline):
+      <block>
+      (1) Create src/calc_power.py with exactly this content (trailing newline):
+      <block>
+      1) src/calc_root.py with exactly:
+      <indented block>
+    Capture each block as everything after the numbered line up to the next numbered line, then dedent.
+    """
+    out: dict[str, str] = {}
+    lines = packet.splitlines()
+    marks = [i for i, l in enumerate(lines) if re.match(r"^\s*(\(\d+\)|\d+\))\s", l)]
+    for k, i in enumerate(marks):
+        m = re.match(r"^\s*(\(\d+\)|\d+\))\s+(.*)$", lines[i])
+        rest = m.group(2)
+        pm = re.search(r"((?:src|tests)/[^\s,]+)", rest)
+        if not pm:
+            continue
+        path = pm.group(1)
+        nxt = marks[k + 1] if k + 1 < len(marks) else len(lines)
+        block = "\n".join(lines[i + 1:nxt]).strip("\n")
+        if not block:
+            continue
+        # dedent a uniformly-indented block (e.g. 4-space indented "1) src/calc_root.py with exactly:")
+        first = block.splitlines()[0]
+        indent = len(first) - len(first.lstrip(" \t"))
+        if indent and all((l.startswith(" " * indent) or not l.strip()) for l in block.splitlines()):
+            block = "\n".join(l[indent:] if l.strip() else l for l in block.splitlines())
+        out[path] = block
+    return out
+
